# Copy this file to .env.local and fill in real values. Never commit
# .env.local — it is gitignored and holds real secrets.

# --- Site / Supabase (existing) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
ENABLE_SELF_REGISTRATION=false

# --- Resend (production email) ---
# API key from https://resend.com/api-keys. Required for any email send —
# see src/lib/email/resend.ts's lazy client construction: the app does NOT
# crash at startup/import without this, only the actual send call fails.
RESEND_API_KEY=
# Sender address. Must use a domain verified in Resend (see the deployment
# checklist in docs/superpowers/specs/2026-07-30-controlled-account-provisioning-design.md
# section 15). Example: RCOY MENA 2026 <participants@rcoymena.org>
RESEND_FROM_EMAIL=
# Optional reply-to address shown to recipients. Falls back to
# PARTICIPANT_SUPPORT_EMAIL if unset.
RESEND_REPLY_TO_EMAIL=
# Secret used to verify Resend webhook signatures (Resend dashboard ->
# Webhooks -> your endpoint -> Signing Secret). Required for the webhook
# route to accept any event — an unset value causes every webhook request
# to be rejected, not silently accepted.
RESEND_WEBHOOK_SECRET=

# --- QR credential encryption (Phase 6.1) ---
# One key per qr_encryption_key_registry.key_version — see
# docs/superpowers/specs/2026-08-12-qr-token-format-and-lifecycle.md §7.
# Each value is 32 raw random bytes, base64url-encoded WITHOUT padding.
# Server-only: never prefix these NEXT_PUBLIC_*, never commit real values.
# Fake placeholder shown below is NOT a usable key — generate real key
# material out-of-band (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`)
# and store only in trusted server-side secrets configuration.
# QR_ENCRYPTION_KEY_V1=REPLACE_WITH_32_RANDOM_BYTES_BASE64URL_NO_PADDING

# --- Application ---
# Public base URL used in participant-facing email content (login link).
# Distinct from NEXT_PUBLIC_SITE_URL (used for Supabase Auth redirectTo
# targets) so the two can be pointed at different values if ever needed,
# though they are typically identical.
APP_URL=http://localhost:3000
# Support contact shown in participant emails and as the default reply-to.
PARTICIPANT_SUPPORT_EMAIL=support@rcoymena.org
